# Supabase — copy this file to .env.local and fill in your project values
# Find these in your Supabase dashboard: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER expose to the browser.
# Used for privileged admin operations (e.g. deleting media from storage).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The email address allowed to access the admin dashboard.
# Create this user in Supabase Auth (Authentication → Users → Add user).
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Public base URL of the site (used for share links). Optional in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — powers the contact form email delivery (get a key at resend.com).
# Server-only; never prefix with NEXT_PUBLIC.
RESEND_API_KEY=re_your_resend_api_key
# Where contact-form messages are delivered (falls back to Settings contact email).
CONTACT_TO_EMAIL=you@example.com
# Sender address. Use onboarding@resend.dev for testing, or a verified domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Web Push notifications — generate with: npx web-push generate-vapid-keys
# The public key is exposed to the browser; keep the private key server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
