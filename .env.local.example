# Supabase — copy this file to .env.local and fill in your project values
# Find these in your Supabase dashboard: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER expose to the browser.
# Used for privileged admin operations (e.g. deleting media from storage).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The email address allowed to access the admin dashboard.
# Create this user in Supabase Auth (Authentication → Users → Add user).
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Public base URL of the site (used for share links). Optional in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
